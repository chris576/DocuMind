{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@paperless/shared/*": ["./packages/shared/src/*"],
      "@paperless/config/*": ["./packages/config/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
