{
  "name": "@documind/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./dto": "./src/dto/index.ts",
    "./interfaces": "./src/interfaces/index.ts",
    "./enums": "./src/enums/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.{js,mjs,cjs}\" --no-error-on-unmatched-pattern",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
