# ==========================================================================
# DocuMind — Umgebungsvariablen (vollständig)
# Kopiere diese Datei nach .env und passe die Werte an.
# Enthält ALLE von Backend & Python-Pipelines gelesenen Variablen.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. DMS / Dokumentenquelle (Paperless)
# --------------------------------------------------------------------------
PAPERLESS_API_URL=http://localhost:8000
PAPERLESS_API_TOKEN=your-paperless-token
PAPERLESS_USERNAME=RAG-Agent

# Generischer Document-Provider (fällt auf die Paperless-Variablen zurück)
DOCUMENT_PROVIDER=paperless
DOCUMENT_PROVIDER_URL=${PAPERLESS_API_URL}
DOCUMENT_PROVIDER_TOKEN=${PAPERLESS_API_TOKEN}

# --------------------------------------------------------------------------
# 2. Vektor-DB / Embeddings / Reranker
# --------------------------------------------------------------------------
VECTOR_DB_TYPE=chroma                 # chroma | qdrant | pgvector
EMBEDDING_PROVIDER=sentence_transformer
# EMBEDDING_MODEL: Alias oder voller HF-Name (Katalog: embeddings/models.py).
#   minilm-multilingual (384) | e5-small-multilingual (384) | mpnet-multilingual (768)
#   e5-base-multilingual (768) | e5-large-multilingual (1024) | bge-m3 (1024)
#   ACHTUNG: Dimensionswechsel (≠384) erfordert Re-Indexing der Vector-DB.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_PROVIDER=cross_encoder
# CROSS_ENCODER_MODEL: Alias oder voller HF-Name (Katalog: reranking/models.py).
#   msmarco-minilm | mmarco-multilingual | bge-reranker-base | bge-reranker-m3
#   mxbai-rerank-base | jina-reranker-multilingual
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COLLECTION_NAME=documents
SIMILARITY_METRIC=cosine

CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PGVECTOR_URL=postgresql://paperless:paperless@localhost:5433/paperless_ai

# --------------------------------------------------------------------------
# 3. Hybrid Search / Keyword (BM25) Tuning
# --------------------------------------------------------------------------
KEYWORD_METHOD=auto                   # auto | native (qdrant) | fts (pgvector) | local (chroma)
KEYWORD_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
FTS_LANGUAGE=german                    # Sprache für pgvector to_tsvector
KEYWORD_INDEX_FILE=./data/bm25_index.pkl

# --------------------------------------------------------------------------
# 4. LLM (Generation-Pipeline)
# --------------------------------------------------------------------------
LLM_PROVIDER=ollama                   # openai | ollama | anthropic | custom
LLM_MODEL=llama3.2

OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434       # wird von python-llm gelesen
OLLAMA_API_URL=http://localhost:11434        # wird von Backend / docker-compose gelesen
ANTHROPIC_API_KEY=

# Custom-Provider (z.B. DeepSeek): CUSTOM_BASE_URL / CUSTOM_API_KEY / CUSTOM_MODEL
# sind in der LEGACY-Sektion unten definiert.

# --------------------------------------------------------------------------
# 5. Backend (NestJS)
# --------------------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3001
DATABASE_URL=postgresql://paperless:paperless@localhost:5432/paperless_ai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# API_KEY (für den API-Key-Guard) ist in der LEGACY-Sektion unten definiert.

# --------------------------------------------------------------------------
# 6. Inter-Service-URLs & Pipeline-Ports
# --------------------------------------------------------------------------
# Container-/Netzwerk-Port je Pipeline (FastAPI bindet uvicorn an diesen Port)
INGESTION_PORT=8001
RETRIEVAL_PORT=8002
GENERATION_PORT=8003
# Host-/publizierter Port (docker compose "ports" / docker run "-p")
INGESTION_HOST_PORT=8001
RETRIEVAL_HOST_PORT=8002
GENERATION_HOST_PORT=8003

# Backend-Verbindung zu den Pipelines. Host und Port müssen zu den *_PORT-Werten passen.
INGESTION_PIPELINE_URL=http://localhost:8001
RETRIEVAL_PIPELINE_URL=http://localhost:8002
GENERATION_PIPELINE_URL=http://localhost:8003

MAX_RESULTS=20                        # Retrieval-Pipeline

# Frontend
VITE_API_URL=http://localhost:3001

# --------------------------------------------------------------------------
# 7. Optionale Feature-Flags
# --------------------------------------------------------------------------
EXTERNAL_API_ENABLED=false

# --------------------------------------------------------------------------
# 8. Gateway / MCP / Admin-Panel Config
# --------------------------------------------------------------------------
# Pfad zur JSON-Konfigurationsdatei des Gateways (Admin-Panel). Enthält die
# Nicht-Secret-Einstellungen (LLM, Connectors, Vector-DB, Hybrid-Suche).
# Secrets bleiben als *Env-Referenzen in der Datei bzw. direkt in Env.
CONFIG_FILE=./config/config.json

# Statisches Bearer-Token für den Gateway (Admin-Panel + MCP). Leer = Auth deaktiviert.
GATEWAY_API_TOKEN=

# Basis-URL des Gateways für Pipelines und lokalen MCP-Server.
GATEWAY_URL=http://localhost:3001

# Namespace → Pipeline-URLs (optional; Routing-Tabelle statt einzelner *_PIPELINE_URL).
# PIPELINE_REGISTRY_JSON=[{"namespace":"paperless","ingestionUrl":"http://localhost:8001"}]

# Namespace → Container-Name für den scoped Restart (Control-Plane).
# PIPELINE_CONTAINER_MAP={"paperless":"documind-ingestion"}
