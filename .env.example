# ==========================================================================
# DocuMind — Umgebungsvariablen (vollständig)
# Kopiere diese Datei nach .env und passe die Werte an.
# Enthält ALLE von Backend & Python-Pipelines gelesenen Variablen.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. DMS / Dokumentenquelle (Paperless)
# --------------------------------------------------------------------------
PAPERLESS_API_URL=http://localhost:8000
PAPERLESS_API_TOKEN=your-paperless-token
PAPERLESS_USERNAME=RAG-Agent

# Generischer Document-Provider (fällt auf die Paperless-Variablen zurück)
DOCUMENT_PROVIDER=paperless
DOCUMENT_PROVIDER_URL=${PAPERLESS_API_URL}
DOCUMENT_PROVIDER_TOKEN=${PAPERLESS_API_TOKEN}

# --------------------------------------------------------------------------
# 2. Vektor-DB / Embeddings / Reranker
# --------------------------------------------------------------------------
VECTOR_DB_TYPE=chroma                 # chroma | qdrant | pgvector
EMBEDDING_PROVIDER=sentence_transformer
# EMBEDDING_MODEL: Alias oder voller HF-Name (Katalog: embeddings/models.py).
#   minilm-multilingual (384) | e5-small-multilingual (384) | mpnet-multilingual (768)
#   e5-base-multilingual (768) | e5-large-multilingual (1024) | bge-m3 (1024)
#   ACHTUNG: Dimensionswechsel (≠384) erfordert Re-Indexing der Vector-DB.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_PROVIDER=cross_encoder
# CROSS_ENCODER_MODEL: Alias oder voller HF-Name (Katalog: reranking/models.py).
#   msmarco-minilm | mmarco-multilingual | bge-reranker-base | bge-reranker-m3
#   mxbai-rerank-base | jina-reranker-multilingual
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COLLECTION_NAME=documents
SIMILARITY_METRIC=cosine

CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PGVECTOR_URL=postgresql://paperless:paperless@localhost:5433/paperless_ai

# --------------------------------------------------------------------------
# 3. Hybrid Search / Keyword (BM25) Tuning
# --------------------------------------------------------------------------
KEYWORD_METHOD=auto                   # auto | native (qdrant) | fts (pgvector) | local (chroma)
KEYWORD_WEIGHT=0.3
SEMANTIC_WEIGHT=0.7
FTS_LANGUAGE=german                    # Sprache für pgvector to_tsvector
KEYWORD_INDEX_FILE=./data/bm25_index.pkl

# --------------------------------------------------------------------------
# 4. LLM (Generation-Pipeline)
# --------------------------------------------------------------------------
LLM_PROVIDER=ollama                   # openai | ollama | anthropic | custom
LLM_MODEL=llama3.2

OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434       # wird von python-llm gelesen
OLLAMA_API_URL=http://localhost:11434        # wird von Backend / docker-compose gelesen
ANTHROPIC_API_KEY=

# Custom-Provider (z.B. DeepSeek): CUSTOM_BASE_URL / CUSTOM_API_KEY / CUSTOM_MODEL
# sind in der LEGACY-Sektion unten definiert.

# --------------------------------------------------------------------------
# 5. Backend (NestJS)
# --------------------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3001
DATABASE_URL=postgresql://paperless:paperless@localhost:5432/paperless_ai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# API_KEY (für den API-Key-Guard) ist in der LEGACY-Sektion unten definiert.

# --------------------------------------------------------------------------
# 6. Inter-Service-URLs & Pipeline-Ports
# --------------------------------------------------------------------------
# Container-/Netzwerk-Port je Pipeline (FastAPI bindet uvicorn an diesen Port)
INGESTION_PORT=8001
RETRIEVAL_PORT=8002
GENERATION_PORT=8003
# Host-/publizierter Port (docker compose "ports" / docker run "-p")
INGESTION_HOST_PORT=8001
RETRIEVAL_HOST_PORT=8002
GENERATION_HOST_PORT=8003

# Backend-Verbindung zu den Pipelines. Host und Port müssen zu den *_PORT-Werten passen.
INGESTION_PIPELINE_URL=http://localhost:8001
RETRIEVAL_PIPELINE_URL=http://localhost:8002
GENERATION_PIPELINE_URL=http://localhost:8003

MAX_RESULTS=20                        # Retrieval-Pipeline

# Frontend
VITE_API_URL=http://localhost:3001

# --------------------------------------------------------------------------
# 7. Optionale Feature-Flags
# --------------------------------------------------------------------------
EXTERNAL_API_ENABLED=false

# --------------------------------------------------------------------------
# 8. LEGACY (alte paperless-ai Node-App) — nur bei Bedarf
# --------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_MODEL=

SCAN_INTERVAL=*/30 * * * *
SYSTEM_PROMPT=`You are a personalized document analyzer. Your task is to analyze documents and extract relevant information.\n\nAnalyze the document content and extract the following information into a structured JSON object:\n\n1. title: Create a concise, meaningful title for the document\n2. correspondent: Identify the sender/institution but do not include addresses\n3. tags: Select up to 4 relevant thematic tags\n4. document_date: Extract the document date (format: YYYY-MM-DD)\n5. language: Determine the document language (e.g. "de" or "en")\n      \nImportant rules for the analysis:\n\nFor tags:\n- FIRST check the existing tags before suggesting new ones\n- Use only relevant categories\n- Maximum 4 tags per document, less if sufficient (at least 1)\n- Avoid generic or too specific tags\n- Use only the most important information for tag creation\n- The output language is the one used in the document! IMPORTANT!\n\nFor the title:\n- Short and concise, NO ADDRESSES\n- Contains the most important identification features\n- For invoices/orders, mention invoice/order number if available\n- The output language is the one used in the document! IMPORTANT!\n\nFor the correspondent:\n- Identify the sender or institution\n  When generating the correspondent, always create the shortest possible form of the company name (e.g. "Amazon" instead of "Amazon EU SARL, German branch")\n\nFor the document date:\n- Extract the date of the document\n- Use the format YYYY-MM-DD\n- If multiple dates are present, use the most relevant one\n\nFor the language:\n- Determine the document language\n- Use language codes like "de" for German or "en" for English\n- If the language is not clear, use "und" as a placeholder
`

PAPERLESS_AI_INITIAL_SETUP=yes
SCAN_INTERVAL=*/30 * * * *
SYSTEM_PROMPT=`You are a personalized document analyzer. Your task is analyze documents and extract relevant information.\n\nAnalyze the document content and extract the following information into a structured JSON object:\n\n1. title: Create a concise, meaningful title for the document\n2. correspondent: Identify the sender/institution but do not include addresses\n3. tags: Select up to 4 relevant thematic tags\n4. document_date: Extract the document date (format: YYYY-MM-DD)\n5. language: Determine the document language (e.g. "de" or "en")\n      \nImportant rules for the analysis:\n\nFor tags:\n- FIRST check the existing tags before suggesting new ones\n- Use only relevant categories\n- Maximum 4 tags per document, less if sufficient (at least 1)\n- Avoid generic or too specific tags\n- Use only the most important information for tag creation\n- The output language is the one used in the document! IMPORTANT!\n\nFor the title:\n- Short and concise, NO ADDRESSES\n- Contains the most important identification features\n- For invoices/orders, mention invoice/order number if available\n- The output language is the one used in the document! IMPORTANT!\n\nFor the correspondent:\n- Identify the sender or institution\n  When generating the correspondent, always create the shortest possible form of the company name (e.g. "Amazon" instead of "Amazon EU SARL, German branch")\n\nFor the document date:\n- Extract the date of the document\n- Use the format YYYY-MM-DD\n- If multiple dates are present, use the most relevant one\n\nFor the language:\n- Determine the document language\n- Use language codes like "de" for German or "en" for English\n- If the language is not clear, use "und" as a placeholder
`

PROCESS_PREDEFINED_DOCUMENTS=yes
TAGS=pre-process
ADD_AI_PROCESSED_TAG=no
AI_PROCESSED_TAG_NAME=ai-processed
USE_PROMPT_TAGS=no
PROMPT_TAGS=
USE_EXISTING_DATA=no
API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CUSTOM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxx
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_MODEL=deepseek-chat
